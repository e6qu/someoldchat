#!/usr/bin/env bash
# Refuse a push whose dependency pins the admission policy would reject
# (specs/dependency-policy.md), the same verdict CI's Go checks reach, so an
# under-age pin is caught before it reaches a pull request rather than after.
# Install with `make hooks`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
make --no-print-directory dependency-check
