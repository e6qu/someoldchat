# syntax=mirror.gcr.io/docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# The Dockerfile frontend comes from Google's Docker Hub mirror and the Go image
# from the Amazon ECR Public copy of Docker's official images, both pinned to the
# digest Docker Hub serves: Docker Hub limits anonymous pulls per address, and
# the shared CI runners exhaust it.
FROM --platform=$BUILDPLATFORM public.ecr.aws/docker/library/golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 AS build

ARG TARGETOS
ARG TARGETARCH

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' -o /out/sameoldchat-worker ./cmd/worker

FROM gcr.io/distroless/static-debian12:nonroot@sha256:aef9602f8710ec12bde19d593fed1f76c708531bb7aba205110f1029786ead7b
COPY --from=build /out/sameoldchat-worker /sameoldchat-worker
USER nonroot:nonroot
ENTRYPOINT ["/sameoldchat-worker"]
